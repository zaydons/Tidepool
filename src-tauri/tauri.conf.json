{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tidepool",
  "version": "../package.json",
  "identifier": "com.zaydons.tidepool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tidepool",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Sal Zaydon",
    "copyright": "© 2026 Sal Zaydon. MIT License.",
    "category": "DeveloperTool",
    "shortDescription": "Cross-platform MQTT explorer",
    "longDescription": "Tidepool connects to an MQTT broker and shows a live topic tree, message history and payloads, and lets you publish messages.",
    "homepage": "https://github.com/zaydons/Tidepool",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "section": "devel"
      },
      "rpm": {
        "release": "1"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFRDNENDVBNTY4ODVFQjcKUldTM1hvaFdXdFRUem1UZS9iZDhMRXUzOGd0YlBQWGVoUGJzTU00UkhxeHFwMlVLREU4V3A0Q0IK",
      "endpoints": [
        "https://github.com/zaydons/Tidepool/releases/latest/download/latest.json"
      ]
    }
  }
}
